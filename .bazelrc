# Common Bazel settings for the experimental repo
# startup --output_base=.bazel_output

# Termux workaround: disable network metrics collection (causes
# NullPointerException)
common --noexperimental_collect_system_network_usage

# Build settings - LLM optimized for minimal noise
build --remote_local_fallback
build --show_progress_rate_limit=60
build --curses=no
build --color=no
build --verbose_failures

# General build safety
build --incompatible_disallow_empty_glob  # Fail if glob patterns match no files
build --incompatible_strict_action_env   # Keep caller PATH out of action/test cache keys

# Go-specific settings
build --@rules_go//go/config:race=false   # Race detector (enable for debugging concurrency)
build --@rules_go//go/config:msan=false   # Memory sanitizer (enable for memory debugging)
build --@rules_go//go/config:static=true  # Static linking (enable for portable binaries)
build --@rules_go//go/config:pure=true    # Pure Go without cgo (disable for cross-compilation)

# Test settings - minimal output with meaningful summaries
test --test_output=errors
test --test_summary=short
test --nobuild_tests_only

# Performance settings
build --jobs=auto
test --jobs=auto

# Termux configuration (Android)
# Usage: bazel build --config=termux //...
# Disables nogo analyzers which have issues with Termux's environment
build:termux --//tools/lint:skip_nogo=true

# BuildBuddy BES + remote cache (opt-in; API key belongs in .bazelrc.local or CI)
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_upload_local_results=true
build:buildbuddy --remote_download_toplevel
build:buildbuddy --remote_cache_compression
build:buildbuddy --noslim_profile
build:buildbuddy --experimental_profile_include_target_label
build:buildbuddy --experimental_profile_include_primary_output

# BuildBuddy Remote Build Execution (opt-in; extends buildbuddy)
build:rbe --config=buildbuddy
build:rbe --remote_executor=grpcs://remote.buildbuddy.io
build:rbe --jobs=50
build:rbe --platforms=@toolchains_buildbuddy//platforms:linux_x86_64
build:rbe --extra_execution_platforms=@toolchains_buildbuddy//platforms:linux_x86_64
build:rbe --extra_toolchains=@toolchains_buildbuddy//toolchains/cc:ubuntu_gcc_x86_64

# Developer settings
# build --sandbox_debug
# test --test_verbose_timeout_warnings

try-import %workspace%/.bazelrc.user
try-import %workspace%/.bazelrc.local
