# Go
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# Staticcheck analyzers for nogo (bzlmod-compatible)
bazel_dep(name = "nogo_analyzer_bzlmod", version = "0.1.0")

# Configure Go version to match go.mod toolchain requirement.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.10",
)
go_sdk.nogo(nogo = "//tools/lint:platform_nogo")
use_repo(go_sdk, "go_sdk")

bazel_dep(name = "gazelle", version = "0.54.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Explicitly declare golang.org/x/tools for nogo ADDITIONAL_GOVET analyzers
# This prevents bazel mod tidy from removing it as an "indirect" dependency
go_deps.module(
    path = "golang.org/x/tools",
    sum = "h1:ryxg4U63oaUYk7uOLTF37n43f4qgtGvqV4Ioit1BaEs=",
    version = "v0.52.0",
)
go_deps.module(
    path = "github.com/gordonklaus/ineffassign",
    sum = "h1:Uths4KnmwxNJNzq87fwQQDDnbNb7De00VOk9Nu0TySs=",
    version = "v0.2.0",
)
go_deps.module(
    path = "github.com/securego/gosec/v2",
    sum = "h1:67aF6LHa7SAL6QEc4es857GrXTT50gUqmrl0XPhtDx0=",
    version = "v2.30.0",
)

# All Go dependencies referenced by BUILD files must be listed explicitly.
# Note: This includes both direct and indirect dependencies from go.mod.
# gazelle:repository_macro go_deps.bzl%go_repositories
use_repo(
    go_deps,
    "com_github_apple_pkl_go",
    "com_github_bkielbasa_cyclop",
    "com_github_bmatcuk_doublestar_v4",
    "com_github_charmbracelet_bubbles",
    "com_github_charmbracelet_bubbletea",
    "com_github_charmbracelet_lipgloss",
    "com_github_creack_pty",
    "com_github_fsnotify_fsnotify",
    "com_github_go_critic_go_critic",
    "com_github_google_renameio_v2",
    "com_github_gordonklaus_ineffassign",
    "com_github_jaeyeom_go_cmdexec",
    "com_github_jaeyeom_godernize",
    "com_github_jaeyeom_sugo",
    "com_github_kisielk_errcheck",
    "com_github_ldez_tagliatelle",
    "com_github_leanovate_gopter",
    "com_github_mattn_go_sqlite3",
    "com_github_muesli_termenv",
    "com_github_openpeedeep_depguard_v2",
    "com_github_pelletier_go_toml_v2",
    "com_github_securego_gosec_v2",
    "com_github_slack_go_slack",
    "com_github_spf13_cobra",
    "com_github_spf13_viper",
    "com_github_tetafro_godot",
    "com_github_tomarrell_wrapcheck_v2",
    "com_github_uudashr_iface",
    "in_gopkg_yaml_v3",
    "org_golang_x_image",
    "org_golang_x_sys",
    "org_golang_x_tools",
    "org_modernc_sqlite",
)

# Aspect rules for linting and formatting
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")

# Buildifier for Bazel file formatting
bazel_dep(name = "buildifier_prebuilt", version = "10.2.0")

# Stardoc for Bazel documentation (required by rules_buf)
# repo_name provides the legacy @io_bazel_stardoc alias that rules_buf expects
bazel_dep(name = "stardoc", version = "0.8.1", repo_name = "io_bazel_stardoc")

# Buf rules for protocol buffer formatting
bazel_dep(name = "rules_buf", version = "0.6.1")

# Configure Buf toolchain
buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")

# Use the latest buf CLI version
buf.toolchains(
    sha256 = "736e74d1697dcf253bc60b2f0fb4389c39dbc7be68472a7d564a953df8b19d12",
    version = "v1.50.0",
)

# Make buf CLI available for direct usage
use_repo(buf, "rules_buf_toolchains")

# Python
bazel_dep(name = "rules_shell", version = "0.10.0")
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    pyproject_toml = "//:pyproject.toml",
    python_version = "3.11",
    target_platforms = [
        "linux_aarch64",
        "linux_x86_64",
        "osx_aarch64",
        "osx_x86_64",
    ],
    uv_lock = "//:uv.lock",
)
use_repo(pip, "pypi")

# Hermetic uv binaries for lockfile verification (matches pip.parse platforms).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_UV_VERSION = "0.13.9"

_UV_BUILD_FILE = 'exports_files(["uv"])\n'

http_archive(
    name = "uv_linux_aarch64",
    build_file_content = _UV_BUILD_FILE,
    sha256 = "37fbb7c5bc66cf99c12aa881949d216181e201dec449772c4329e56487d61179",
    strip_prefix = "uv-aarch64-unknown-linux-musl",
    urls = ["https://github.com/astral-sh/uv/releases/download/{v}/uv-aarch64-unknown-linux-musl.tar.gz".format(v = _UV_VERSION)],
)

http_archive(
    name = "uv_linux_x86_64",
    build_file_content = _UV_BUILD_FILE,
    sha256 = "58ccf5f1792b8a5a88d01bc910ea131a8b3db4a319a17ad5fad75e0845a3e271",
    strip_prefix = "uv-x86_64-unknown-linux-musl",
    urls = ["https://github.com/astral-sh/uv/releases/download/{v}/uv-x86_64-unknown-linux-musl.tar.gz".format(v = _UV_VERSION)],
)

http_archive(
    name = "uv_osx_aarch64",
    build_file_content = _UV_BUILD_FILE,
    sha256 = "5aeca67f2283f75235de40d0bd9c0a5bbc5fce23b6d48b3bf9fa1b2db08382ca",
    strip_prefix = "uv-aarch64-apple-darwin",
    urls = ["https://github.com/astral-sh/uv/releases/download/{v}/uv-aarch64-apple-darwin.tar.gz".format(v = _UV_VERSION)],
)

http_archive(
    name = "uv_osx_x86_64",
    build_file_content = _UV_BUILD_FILE,
    sha256 = "617a3211261b0fc739562f0071aa34e9739797c510208ede8e2977c30903d041",
    strip_prefix = "uv-x86_64-apple-darwin",
    urls = ["https://github.com/astral-sh/uv/releases/download/{v}/uv-x86_64-apple-darwin.tar.gz".format(v = _UV_VERSION)],
)

# Pinned gitleaks binaries for git history secret scanning.
_GITLEAKS_VERSION = "8.30.1"

_GITLEAKS_BUILD_FILE = 'exports_files(["gitleaks"])\n'

http_archive(
    name = "gitleaks_linux_aarch64",
    build_file_content = _GITLEAKS_BUILD_FILE,
    sha256 = "e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080",
    urls = ["https://github.com/gitleaks/gitleaks/releases/download/v{v}/gitleaks_{v}_linux_arm64.tar.gz".format(v = _GITLEAKS_VERSION)],
)

http_archive(
    name = "gitleaks_linux_x86_64",
    build_file_content = _GITLEAKS_BUILD_FILE,
    sha256 = "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb",
    urls = ["https://github.com/gitleaks/gitleaks/releases/download/v{v}/gitleaks_{v}_linux_x64.tar.gz".format(v = _GITLEAKS_VERSION)],
)

http_archive(
    name = "gitleaks_osx_aarch64",
    build_file_content = _GITLEAKS_BUILD_FILE,
    sha256 = "b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5",
    urls = ["https://github.com/gitleaks/gitleaks/releases/download/v{v}/gitleaks_{v}_darwin_arm64.tar.gz".format(v = _GITLEAKS_VERSION)],
)

http_archive(
    name = "gitleaks_osx_x86_64",
    build_file_content = _GITLEAKS_BUILD_FILE,
    sha256 = "dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709",
    urls = ["https://github.com/gitleaks/gitleaks/releases/download/v{v}/gitleaks_{v}_darwin_x64.tar.gz".format(v = _GITLEAKS_VERSION)],
)

# Pkl for configuration
bazel_dep(name = "rules_pkl", version = "0.18.0")

pkl = use_extension("@rules_pkl//pkl/extensions:pkl.bzl", "pkl")
pkl.project(
    name = "pkl_project",
    pkl_project = "//:PklProject",
    pkl_project_deps = "//:PklProject.deps.json",
)
use_repo(pkl, "pkl-cli-linux-aarch64", "pkl-cli-linux-amd64", "pkl-cli-macos-aarch64", "pkl-cli-macos-amd64", "pkl-doc-cli-linux-aarch64", "pkl-doc-cli-linux-amd64", "pkl-doc-cli-macos-aarch64", "pkl-doc-cli-macos-amd64", "pkl_project")

# BuildBuddy RBE toolchain
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
use_repo(buildbuddy, "buildbuddy_toolchain")
