py_test(
    name = "semgrep_unit_test",
    size = "small",
    srcs = ["semgrep_test.py"],
    args = [
        "-k",
        "not(test_repo_passes_semgrep)",
    ],
    data = [
        ":pysemgrep_bin",
        ":semgrep_bin",
        "//:semgrep_config",
        "@semgrep_rules//:README.md",
        "@semgrep_rules//:rules",
    ],
    env = {
        "PYSEMGREP_BIN": "$(rootpath :pysemgrep_bin)",
        "SEMGREP_BIN": "$(rootpath :semgrep_bin)",
        "SEMGREP_CONFIG_FILES": "$(rootpaths //:semgrep_config)",
        "SEMGREP_RULES_ANCHOR": "$(rootpath @semgrep_rules//:README.md)",
    },
    legacy_create_init = 0,
    main = "semgrep_test.py",
    target_compatible_with = _SEMGREP_COMPATIBLE,
    deps = [
        "@pypi//pytest",
        "@pypi//ruamel_yaml",
    ],
)

