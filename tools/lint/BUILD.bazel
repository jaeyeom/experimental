        ],
        data = [
            ":pysemgrep_bin",
            ":semgrep_%s_manifest" % lang,
            ":semgrep_bin",
            srcs_label,
            "@semgrep_rules//:README.md",
            "@semgrep_rules//:rules",
        ] + (["//:semgrep_config"] if use_custom else []),
        env = {
            "PYSEMGREP_BIN": "$(rootpath :pysemgrep_bin)",
            "SEMGREP_BIN": "$(rootpath :semgrep_bin)",
            "SEMGREP_MANIFEST": "$(rootpath :semgrep_%s_manifest)" % lang,
            "SEMGREP_RULE_SUBDIRS": rule_subdirs,
            "SEMGREP_RULES_ANCHOR": "$(rootpath @semgrep_rules//:README.md)",
            "SEMGREP_USE_CUSTOM_CONFIG": "1" if use_custom else "0",
        } | (
            {"SEMGREP_CONFIG_FILES": "$(rootpaths //:semgrep_config)"} if use_custom else {}
        ),
        legacy_create_init = 0,
        main = "semgrep_test.py",
        target_compatible_with = _SEMGREP_COMPATIBLE,
        deps = [
            "@pypi//pytest",
            "@pypi//ruamel_yaml",
        ],
    )
    for lang, srcs_label, rule_subdirs, use_custom in _SEMGREP_SCANS
]

