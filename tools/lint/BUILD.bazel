load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@nogo_analyzer_bzlmod//:def.bzl", "ANALYZERS", "staticcheck_analyzers")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "nogo")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//devtools/linters/pylinters:py_entries.bzl", "py_entries_manifest")
load(":linters.bzl", "ruff_test", "shellcheck_test")

package(default_visibility = ["//:__subpackages__"])

# grpcio wheels are not expected on Termux/Android.
_PY_COMPATIBLE = select({
    "@platforms//os:linux": [],
    "@platforms//os:osx": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Flag to skip nogo analyzers (for Termux/Android compatibility)
# Usage: bazel build --//tools/lint:skip_nogo=true //...
# Or use: bazel build --config=termux //...
bool_flag(
    name = "skip_nogo",
    build_setting_default = False,
)

config_setting(
    name = "skip_nogo_enabled",
    flag_values = {":skip_nogo": "True"},
)

exports_files([
    "linters.bzl",
])

alias(
    name = "buf",
    actual = "@rules_buf_toolchains//:buf",
)

# Extra govet analyzers not bundled in TOOLS_NOGO.
# TODO: Add shadow analyzer once all shadow issues in codebase are fixed:
#   "@org_golang_x_tools//go/analysis/passes/shadow:go_default_library",
ADDITIONAL_GOVET = [
    "@org_golang_x_tools//go/analysis/passes/unusedwrite:go_default_library",
]

EXTRA_ANALYZERS = [
    "//devtools/linters/cyclop:go_default_library",
    "//devtools/linters/depguard:go_default_library",
    "//devtools/linters/errcheck:go_default_library",
    "//devtools/linters/gochecknoinits:go_default_library",
    "//devtools/linters/gocritic:go_default_library",
    "//devtools/linters/godot:go_default_library",
    "//devtools/linters/pkgvar:go_default_library",
    "//devtools/linters/tagliatelle:go_default_library",
    "//devtools/linters/wrapcheck:go_default_library",
    "@com_github_gordonklaus_ineffassign//pkg/ineffassign:go_default_library",
    "@com_github_jaeyeom_godernize//oserrors:go_default_library",
    "@com_github_securego_gosec_v2//goanalysis:go_default_library",
    "@com_github_uudashr_iface//identical:go_default_library",
    "@com_github_uudashr_iface//opaque:go_default_library",
    "@com_github_uudashr_iface//unexported:go_default_library",
    "@com_github_uudashr_iface//unused:go_default_library",
]

nogo(
    name = "platform_nogo",
    config = "nogo.json",
    visibility = ["//visibility:public"],
    # Use --//tools/lint:skip_nogo=true or --config=termux to skip analyzers
    deps = select({
        ":skip_nogo_enabled": [],
        "//conditions:default": TOOLS_NOGO + ADDITIONAL_GOVET + EXTRA_ANALYZERS + staticcheck_analyzers(ANALYZERS),
    }),
)

ruff_test(
    name = "ruff_test",
    size = "small",
    srcs = ["//devtools/linters/pylinters:repo_py_srcs"],
)

sh_test(
    name = "ruff_config_test",
    size = "small",
    srcs = ["ruff_config_test.sh"],
    args = [
        "$(rootpath @aspect_rules_lint//lint:ruff_bin)",
        "$(rootpath //:pyproject.toml)",
    ],
    data = [
        "//:pyproject.toml",
        "@aspect_rules_lint//lint:ruff_bin",
    ],
)

py_test(
    name = "mypy_test",
    size = "small",
    srcs = ["mypy_test.py"],
    data = [
        "//:pyproject.toml",
        "//devtools/linters/pylinters:repo_py_srcs",
    ],
    legacy_create_init = 0,
    target_compatible_with = _PY_COMPATIBLE,
    deps = [
        "@pypi//grpcio",
        "@pypi//mypy",
        "@pypi//protobuf",
        "@pypi//protovalidate",
        "@pypi//pytest",
    ],
)

filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
    visibility = ["//devtools/linters/pylinters:__pkg__"],
)

py_entries_manifest(
    name = "py_entries",
    visibility = ["//devtools/linters/pylinters:__pkg__"],
)

filegroup(
    name = "sh_srcs",
    srcs = glob(["*.sh"]),
)

sh_library(
    name = "repo_sh_srcs",
    srcs = [
        ":sh_srcs",
        "//.githooks:sh_srcs",
        "//:sh_srcs",
        "//devtools/decide/web:sh_srcs",
        "//devtools/docsync/internal/cli:sh_srcs",
        "//devtools/fork-keeper:sh_srcs",
        "//devtools/gh-ask/userscript:sh_srcs",
        "//devtools/gh-nudge:sh_srcs",
        "//devtools/prsync/internal/cli:sh_srcs",
        "//devtools/prsync/internal/scan:sh_srcs",
        "//devtools/repo-sync/examples:sh_srcs",
        "//devtools/setup-dev/ansible:sh_srcs",
        "//devtools/setup-dev/qubes:sh_srcs",
        "//scripts:sh_srcs",
        "//spacemacs:sh_srcs",
    ],
)

shellcheck_test(
    name = "shellcheck_test",
    size = "small",
    srcs = [":repo_sh_srcs"],
)

sh_test(
    name = "shellcheck_config_test",
    size = "small",
    srcs = ["shellcheck_config_test.sh"],
    args = [
        "$(rootpath @aspect_rules_lint//lint:shellcheck_bin)",
        "$(rootpath //:.shellcheckrc)",
    ],
    data = [
        "//:.shellcheckrc",
        "@aspect_rules_lint//lint:shellcheck_bin",
    ],
)
