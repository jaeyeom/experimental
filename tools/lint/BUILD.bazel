load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@nogo_analyzer_bzlmod//:def.bzl", "ANALYZERS", "staticcheck_analyzers")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "nogo")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//devtools/linters/pylinters:py_entries.bzl", "py_entries_manifest")
load(":linters.bzl", "file_manifest", "ruff_test", "shellcheck_test")

package(default_visibility = ["//:__subpackages__"])

# grpcio wheels are not expected on Termux/Android.
_PY_COMPATIBLE = select({
    "@platforms//os:linux": [],
    "@platforms//os:osx": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Flag to skip nogo analyzers (for Termux/Android compatibility)
# Usage: bazel build --//tools/lint:skip_nogo=true //...
# Or use: bazel build --config=termux //...
bool_flag(
    name = "skip_nogo",
    build_setting_default = False,
)

config_setting(
    name = "skip_nogo_enabled",
    flag_values = {":skip_nogo": "True"},
)

exports_files([
    "linters.bzl",
])

alias(
    name = "buf",
    actual = "@rules_buf_toolchains//:buf",
)

# Extra govet analyzers not bundled in TOOLS_NOGO.
# TODO: Add shadow analyzer once all shadow issues in codebase are fixed:
#   "@org_golang_x_tools//go/analysis/passes/shadow:go_default_library",
ADDITIONAL_GOVET = [
    "@org_golang_x_tools//go/analysis/passes/unusedwrite:go_default_library",
]

EXTRA_ANALYZERS = [
    "//devtools/linters/cyclop:go_default_library",
    "//devtools/linters/depguard:go_default_library",
    "//devtools/linters/errcheck:go_default_library",
    "//devtools/linters/gochecknoinits:go_default_library",
    "//devtools/linters/gocritic:go_default_library",
    "//devtools/linters/godot:go_default_library",
    "//devtools/linters/pkgvar:go_default_library",
    "//devtools/linters/tagliatelle:go_default_library",
    "//devtools/linters/wrapcheck:go_default_library",
    "@com_github_gordonklaus_ineffassign//pkg/ineffassign:go_default_library",
    "@com_github_jaeyeom_godernize//oserrors:go_default_library",
    "@com_github_securego_gosec_v2//goanalysis:go_default_library",
    "@com_github_uudashr_iface//identical:go_default_library",
    "@com_github_uudashr_iface//opaque:go_default_library",
    "@com_github_uudashr_iface//unexported:go_default_library",
    "@com_github_uudashr_iface//unused:go_default_library",
]

nogo(
    name = "platform_nogo",
    config = "nogo.json",
    visibility = ["//visibility:public"],
    # Use --//tools/lint:skip_nogo=true or --config=termux to skip analyzers
    deps = select({
        ":skip_nogo_enabled": [],
        "//conditions:default": TOOLS_NOGO + ADDITIONAL_GOVET + EXTRA_ANALYZERS + staticcheck_analyzers(ANALYZERS),
    }),
)

ruff_test(
    name = "ruff_test",
    size = "small",
    srcs = ["//devtools/linters/pylinters:repo_py_srcs"],
    # BuildBuddy RBE stages input files as executable, causing false EXE002
    # violations; keep both the aspect on repo_py_srcs and this test off RBE.
    tags = ["no-remote"],
)

sh_test(
    name = "ruff_config_test",
    size = "small",
    srcs = ["ruff_config_test.sh"],
    args = [
        "$(rootpath @aspect_rules_lint//lint:ruff_bin)",
        "$(rootpath //:pyproject.toml)",
    ],
    data = [
        "//:pyproject.toml",
        "@aspect_rules_lint//lint:ruff_bin",
    ],
)

py_test(
    name = "mypy_test",
    size = "small",
    srcs = ["mypy_test.py"],
    data = [
        "//:pyproject.toml",
        "//devtools/linters/pylinters:repo_py_srcs",
    ],
    legacy_create_init = 0,
    target_compatible_with = _PY_COMPATIBLE,
    deps = [
        "@pypi//grpcio",
        "@pypi//mypy",
        "@pypi//protobuf",
        "@pypi//protovalidate",
        "@pypi//pytest",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "osx_aarch64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "osx_x86_64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "uv_bin",
    actual = select({
        ":linux_aarch64": "@uv_linux_aarch64//:uv",
        ":linux_x86_64": "@uv_linux_x86_64//:uv",
        ":osx_aarch64": "@uv_osx_aarch64//:uv",
        ":osx_x86_64": "@uv_osx_x86_64//:uv",
    }),
    target_compatible_with = _PY_COMPATIBLE,
)

py_test(
    name = "uv_lock_test",
    size = "small",
    srcs = ["uv_lock_test.py"],
    data = [
        ":uv_bin",
        "//:pyproject.toml",
        "//:uv.lock",
    ],
    env = {
        "UV_BIN": "$(rootpath :uv_bin)",
    },
    legacy_create_init = 0,
    target_compatible_with = _PY_COMPATIBLE,
    deps = ["@pypi//pytest"],
)

alias(
    name = "gitleaks_bin",
    actual = select({
        ":linux_aarch64": "@gitleaks_linux_aarch64//:gitleaks",
        ":linux_x86_64": "@gitleaks_linux_x86_64//:gitleaks",
        ":osx_aarch64": "@gitleaks_osx_aarch64//:gitleaks",
        ":osx_x86_64": "@gitleaks_osx_x86_64//:gitleaks",
    }),
    target_compatible_with = _PY_COMPATIBLE,
)

py_test(
    name = "gitleaks_test",
    size = "small",
    srcs = ["gitleaks_test.py"],
    data = [
        ":gitleaks_bin",
        "//:.gitleaks.toml",
        "//:go.mod",
    ],
    env = {
        "GITLEAKS_BIN": "$(rootpath :gitleaks_bin)",
    },
    legacy_create_init = 0,
    # Scans the checkout's .git history via the go.mod symlink. Git history is
    # not a declared input, so "external" keeps Bazel from caching a stale
    # result and "local" keeps it off RBE.
    tags = [
        "external",
        "local",
    ],
    target_compatible_with = _PY_COMPATIBLE,
    deps = ["@pypi//pytest"],
)

# Semgrep dropped macOS x86_64 wheels in 1.83.0 and is unsupported on Termux.
_SEMGREP_COMPATIBLE = select({
    ":linux_aarch64": [],
    ":linux_x86_64": [],
    ":osx_aarch64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

py_console_script_binary(
    name = "semgrep_bin",
    legacy_create_init = 0,
    pkg = "@pypi//semgrep",
    script = "semgrep",
    target_compatible_with = _SEMGREP_COMPATIBLE,
)

py_console_script_binary(
    name = "pysemgrep_bin",
    legacy_create_init = 0,
    pkg = "@pypi//semgrep",
    script = "pysemgrep",
    target_compatible_with = _SEMGREP_COMPATIBLE,
)

