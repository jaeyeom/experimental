load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "external.go",
        "refresh.go",
        "syncer.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/factory/internal/syncer",
    visibility = ["//devtools/factory:__subpackages__"],
    deps = [
        "//devtools/factory/internal/source:go_default_library",
        "//devtools/factory/internal/store:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "external_test.go",
        "refresh_test.go",
        "syncer_test.go",
    ],
    deps = [
        ":go_default_library",
        "//devtools/factory/internal/source:go_default_library",
        "//devtools/factory/internal/source/fake:go_default_library",
        "//devtools/factory/internal/store:go_default_library",
    ],
)
