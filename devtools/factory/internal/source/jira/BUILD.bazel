load("@rules_go//go:def.bzl", "go_library", "go_test")

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//devtools/factory:__subpackages__"],
)

go_library(
    name = "go_default_library",
    srcs = [
        "adf.go",
        "decode.go",
        "http.go",
        "source.go",
        "sync.go",
        "write.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/factory/internal/source/jira",
    visibility = ["//devtools/factory:__subpackages__"],
    deps = [
        "//devtools/factory/internal/config:go_default_library",
        "//devtools/factory/internal/priority:go_default_library",
        "//devtools/factory/internal/source:go_default_library",
        "@com_github_yuin_goldmark//:go_default_library",
        "@com_github_yuin_goldmark//ast:go_default_library",
        "@com_github_yuin_goldmark//text:go_default_library",
        "@com_github_yuin_goldmark//util:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "adf_test.go",
        "claim_test.go",
        "defer_test.go",
        "ids_test.go",
        "jira_test.go",
        "write_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":go_default_library"],
    embedsrcs = [
        "testdata/issue_bad_time.json",
        "testdata/issue_missing_issuetype.json",
        "testdata/issue_missing_status.json",
        "testdata/issue_ok.json",
        "testdata/myself.json",
        "testdata/search_due.json",
        "testdata/search_missing_key.json",
        "testdata/search_no_issues.json",
        "testdata/search_one.json",
        "testdata/search_page1.json",
        "testdata/search_page2.json",
        "testdata/search_priorities.json",
    ],
    deps = [
        "//devtools/factory/internal/config:go_default_library",
        "//devtools/factory/internal/source:go_default_library",
    ],
)
