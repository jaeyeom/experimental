load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["fake.go"],
    importpath = "github.com/jaeyeom/experimental/devtools/factory/internal/source/fake",
    visibility = ["//devtools/factory:__subpackages__"],
    deps = ["//devtools/factory/internal/source:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = ["fake_test.go"],
    deps = [
        ":go_default_library",
        "//devtools/factory/internal/source:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
