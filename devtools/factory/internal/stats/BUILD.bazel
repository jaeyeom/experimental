load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "backlog.go",
        "burndown.go",
        "epics.go",
        "flow.go",
        "split.go",
        "stats.go",
        "text.go",
        "throughput.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/factory/internal/stats",
    visibility = ["//devtools/factory:__subpackages__"],
    deps = [
        "//devtools/factory/internal/backlog:go_default_library",
        "//devtools/factory/internal/config:go_default_library",
        "//devtools/factory/internal/source:go_default_library",
        "//devtools/factory/internal/stats/chart:go_default_library",
        "//devtools/factory/internal/store:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "burndown_golden_test.go",
        "stats_test.go",
        "text_golden_test.go",
        "text_internal_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":go_default_library"],
    deps = [
        "//devtools/factory/internal/config:go_default_library",
        "//devtools/factory/internal/source:go_default_library",
        "//devtools/factory/internal/stats/chart:go_default_library",
        "//devtools/factory/internal/store:go_default_library",
    ],
)
