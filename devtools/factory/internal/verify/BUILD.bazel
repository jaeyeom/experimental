load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "git.go",
        "sections.go",
        "verify.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/factory/internal/verify",
    visibility = ["//devtools/factory:__subpackages__"],
    deps = [
        "//devtools/factory/internal/config:go_default_library",
        "//devtools/factory/internal/gh:go_default_library",
        "//devtools/factory/internal/store:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "sections_test.go",
        "verify_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//devtools/factory/internal/config:go_default_library",
        "//devtools/factory/internal/gh:go_default_library",
        "//devtools/factory/internal/store:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
