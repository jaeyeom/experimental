load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "links.go",
        "lint.go",
        "parse.go",
        "srcblocks.go",
        "structure.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/orglint",
    visibility = ["//visibility:public"],
    deps = ["//devtools/linters/orglintparity:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "links_test.go",
        "parse_test.go",
        "repo_test.go",
        "srcblocks_test.go",
        "structure_test.go",
    ],
    data = [
        "testdata/sample.orgtest",
        "//:go.mod",
        "//devtools:README.org",
        "//devtools/linters/testdata/orglint:fixtures",
    ],
    embed = [":go_default_library"],
    # Lints the checkout's .org files via the go.mod symlink. They are not declared
    # inputs, so "external" keeps Bazel from caching a stale result.
    tags = [
        "external",
        "local",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
