load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "config.go",
        "range.go",
        "reviewer.go",
        "sandbox.go",
        "scheduler.go",
        "tripwires.go",
        "verdict.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/fork-keeper",
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "medium",
    srcs = [
        "config_test.go",
        "range_test.go",
        "reviewer_test.go",
        "sandbox_test.go",
        "scheduler_test.go",
        "testlib_test.go",
        "tripwires_test.go",
        "verdict_test.go",
    ],
    embed = [":go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
