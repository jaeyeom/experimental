load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "entity_cmd.go",
        "event_cmd.go",
        "export_cmd.go",
        "fact_cmd.go",
        "import_cmd.go",
        "main.go",
        "maintenance_cmd.go",
        "note_cmd.go",
        "routine_cmd.go",
        "serve_cmd.go",
        "skill.go",
        "sync_cmd.go",
        "synccheck_cmd.go",
        "toolcli.go",
        "triage_cmd.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/memstore/cmd/memstore",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/memstore:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

go_binary(
    name = "memstore",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "e2e_test.go",
        "main_test.go",
        "routine_cmd_test.go",
        "sync_cmd_test.go",
        "toolcli_test.go",
    ],
    data = ["//devtools/memstore:README.org"],
    embed = [":go_default_library"],
    deps = [
        "//devtools/memstore:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

exports_files(
    ["main.go"],
    visibility = ["//devtools:__pkg__"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
