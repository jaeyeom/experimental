# Example systemd user oneshot service for secretwatch check (paired with secretwatch.timer).
#
# go install puts the binary in ~/go/bin, or in $GOBIN when that is set.
# ExecStart uses %h/go/bin. If GOBIN is somewhere else, edit ExecStart.
#
# Install:
#   cp secretwatch.service secretwatch.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now secretwatch.timer
#   journalctl --user -u secretwatch.service -f

[Unit]
Description=secretwatch: scan systemd journal for leaked secrets

[Service]
Type=oneshot
Environment=PATH=%h/go/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/go/bin/secretwatch check
# Exit 1 means findings were detected and alerted; only 2+ is a failure.
SuccessExitStatus=1
