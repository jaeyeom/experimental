# Example systemd user timer for secretwatch.service.
#
# Install:
#   cp secretwatch.service secretwatch.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now secretwatch.timer

[Unit]
Description=Run secretwatch periodically

[Timer]
OnBootSec=1m
OnUnitActiveSec=5m
Persistent=true

[Install]
WantedBy=timers.target
