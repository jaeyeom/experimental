# Example systemd user service for continuous secretwatch check --follow.
#
# go install puts the binary in ~/go/bin, or in $GOBIN when that is set.
# ExecStart uses %h/go/bin. If GOBIN is somewhere else, edit ExecStart.
#
# Install:
#   cp secretwatch-follow.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now secretwatch-follow.service
#   journalctl --user -u secretwatch-follow.service -f

[Unit]
Description=secretwatch: continuously watch systemd journal for leaked secrets

[Service]
Type=simple
Environment=PATH=%h/go/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/go/bin/secretwatch check --follow
# Exit 1 means findings were detected; only 2+ triggers Restart=on-failure.
SuccessExitStatus=1
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
