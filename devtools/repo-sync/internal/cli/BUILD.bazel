load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "add.go",
        "config.go",
        "init.go",
        "remove.go",
        "root.go",
        "skill.go",
        "status.go",
        "sync.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/repo-sync/internal/cli",
    visibility = ["//devtools/repo-sync:__subpackages__"],
    deps = [
        "//devtools/repo-sync/internal/config:go_default_library",
        "//devtools/repo-sync/internal/database:go_default_library",
        "//devtools/repo-sync/internal/reposync:go_default_library",
        "@com_github_chorong_sh_chorong//pkg/toolcli:go_default_library",
        "@com_github_spf13_cobra//:go_default_library",
        "@com_github_spf13_viper//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = ["toolcli_test.go"],
    embed = [":go_default_library"],
    deps = ["@com_github_chorong_sh_chorong//pkg/toolcli:go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
