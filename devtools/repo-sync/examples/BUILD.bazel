load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "demo",
    srcs = ["demo.sh"],
)

filegroup(
    name = "sh_srcs",
    srcs = glob(["*.sh"]),
    visibility = ["//tools/lint:__pkg__"],
)

filegroup(
    name = "yaml_srcs",
    srcs = glob(
        [
            "*.yml",
            "*.yaml",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
