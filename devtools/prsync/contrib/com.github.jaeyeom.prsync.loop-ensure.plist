<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example hourly launchd watchdog agent for prsync loop ensure on macOS.

  Replace USER with your login name, then:
    cp com.github.jaeyeom.prsync.loop-ensure.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.github.jaeyeom.prsync.loop-ensure.plist

  PATH must contain gh, git, herdr, agentbus, and jira.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.jaeyeom.prsync.loop-ensure</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USER/go/bin/prsync</string>
    <string>loop</string>
    <string>--ensure</string>
    <string>--config</string>
    <string>/Users/USER/.config/prsync/prsync.config</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/USER/go/bin:/Users/USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardErrorPath</key>
  <string>/tmp/prsync-loop-ensure.log</string>
</dict>
</plist>
