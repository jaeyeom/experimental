# Example hourly systemd user timer for prsync-loop-ensure.service.
#
# Install:
#   cp prsync-loop-ensure.service prsync-loop-ensure.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now prsync-loop-ensure.timer

[Unit]
Description=Ensure prsync loop is alive hourly

[Timer]
OnBootSec=1m
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
