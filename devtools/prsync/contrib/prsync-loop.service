# Example systemd user unit for prsync loop.
#
# go install puts the binary in ~/go/bin, or in $GOBIN when that is set.
# ExecStart uses %h/go/bin. If GOBIN is somewhere else, edit ExecStart.
#
# Install:
#   cp prsync-loop.service prsync-loop-ensure.service prsync-loop-ensure.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now prsync-loop.service prsync-loop-ensure.timer
#   journalctl --user -u prsync-loop.service -f
#
# systemd does not read your shell profile, so PATH below must contain
# gh, git, herdr, agentbus, and jira.

[Unit]
Description=prsync: survey open PRs and dispatch to herdr tabs in a loop
Wants=network-online.target
After=network-online.target

[Service]
Environment=PATH=%h/go/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/go/bin/prsync loop --config %h/.config/prsync/prsync.config
Restart=on-failure
RestartSec=30
TimeoutStopSec=35m
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
