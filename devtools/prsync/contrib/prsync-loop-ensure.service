# Example systemd user oneshot service for `prsync loop --ensure`
# (paired with prsync-loop-ensure.timer).
#
# If the loop heartbeat is fresh and the PID is alive, --ensure exits 0 at once;
# otherwise it starts the loop detached.
#
# Install:
#   cp prsync-loop-ensure.service prsync-loop-ensure.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now prsync-loop-ensure.timer

[Unit]
Description=prsync: ensure prsync loop is running

[Service]
Type=oneshot
Environment=PATH=%h/go/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/go/bin/prsync loop --ensure --config %h/.config/prsync/prsync.config
