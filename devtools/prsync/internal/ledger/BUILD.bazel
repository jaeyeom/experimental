load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["ledger.go"],
    importpath = "github.com/jaeyeom/experimental/devtools/prsync/internal/ledger",
    visibility = ["//devtools/prsync:__subpackages__"],
)

go_test(
    name = "go_default_test",
    srcs = ["ledger_test.go"],
    embed = [":go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
