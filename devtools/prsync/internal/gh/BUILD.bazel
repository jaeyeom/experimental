load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "budget.go",
        "client.go",
        "openpr.go",
        "retry.go",
        "teamcover.go",
        "types.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/prsync/internal/gh",
    visibility = ["//devtools/prsync:__subpackages__"],
    deps = [
        "//devtools/pkg/ghcli:go_default_library",
        "//devtools/prsync/internal/runlog:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "apimethod_test.go",
        "client_test.go",
        "cost_test.go",
        "rollup_ttl_test.go",
        "teamcover_budget_test.go",
        "teamcover_split_test.go",
        "teamcover_test.go",
    ],
    data = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    embed = [":go_default_library"],
    deps = [
        "//devtools/prsync/internal/roundcache:go_default_library",
        "//devtools/prsync/internal/runlog:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)
