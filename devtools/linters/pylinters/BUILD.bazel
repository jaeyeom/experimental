load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "pylinters",
    srcs = glob(["src/pylinters/**/*.py"]),
    imports = ["src"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "py-module-import",
    srcs = ["src/pylinters/cli/module_import.py"],
    main = "src/pylinters/cli/module_import.py",
    deps = [":pylinters"],
)

py_binary(
    name = "py-main-guard",
    srcs = ["src/pylinters/cli/main_guard.py"],
    main = "src/pylinters/cli/main_guard.py",
    deps = [":pylinters"],
)

py_binary(
    name = "py-sibling-import",
    srcs = ["src/pylinters/cli/sibling_import.py"],
    main = "src/pylinters/cli/sibling_import.py",
    deps = [":pylinters"],
)

[
    py_test(
        name = name,
        srcs = ["tests/%s.py" % name],
        main = "tests/%s.py" % name,
        deps = [
            ":pylinters",
            "@pypi//pytest",
        ],
    )
    for name in [
        "baseline_test",
        "bazel_test",
        "cli_main_guard_test",
        "cli_module_import_test",
        "cli_sibling_import_test",
        "config_test",
        "entries_test",
        "files_test",
        "globs_test",
        "guards_test",
        "import_time_work_test",
        "imports_test",
        "main_guard_test",
        "module_import_test",
        "names_test",
        "sibling_import_test",
    ]
]
