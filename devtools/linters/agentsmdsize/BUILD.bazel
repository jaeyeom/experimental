load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["agentsmdsize.go"],
    importpath = "github.com/jaeyeom/experimental/devtools/linters/agentsmdsize",
    visibility = ["//visibility:public"],
    deps = ["//devtools/pkg/baseline:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "agentsmdsize_test.go",
        "repo_test.go",
    ],
    data = [
        "//:.baselines/agents-md-size.json",
        "//:go.mod",
    ],
    embed = [":go_default_library"],
    # Checks the checkout's AGENTS.md files via the go.mod symlink. They are not
    # declared inputs, so "external" keeps Bazel from caching a stale result.
    tags = [
        "external",
        "local",
    ],
    deps = ["//devtools/pkg/baseline:go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
