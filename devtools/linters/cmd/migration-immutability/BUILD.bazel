load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/jaeyeom/experimental/devtools/linters/cmd/migration-immutability",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/linters/migrationimmutability:go_default_library",
        "//devtools/pkg/baseline:go_default_library",
        "//devtools/pkg/version:go_default_library",
    ],
)

go_binary(
    name = "migration-immutability",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
    # Shells out to git in throwaway repositories.
    tags = ["local"],
    deps = ["//devtools/pkg/baseline:go_default_library"],
)
