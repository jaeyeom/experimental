load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/jaeyeom/experimental/devtools/linters/cmd/pkgvar",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/linters/pkgvar:go_default_library",
        "//devtools/pkg/version:go_default_library",
        "@org_golang_x_tools//go/analysis/singlechecker:go_default_library",
    ],
)

go_binary(
    name = "pkgvar",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
)

exports_files(
    ["main.go"],
    visibility = ["//devtools:__pkg__"],
)
