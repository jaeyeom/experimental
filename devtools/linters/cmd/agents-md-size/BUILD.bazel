load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/jaeyeom/experimental/devtools/linters/cmd/agents-md-size",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/linters/agentsmdsize:go_default_library",
        "//devtools/pkg/baseline:go_default_library",
        "//devtools/pkg/version:go_default_library",
    ],
)

go_binary(
    name = "agents-md-size",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
    deps = ["//devtools/pkg/baseline:go_default_library"],
)

exports_files(
    ["main.go"],
    visibility = ["//devtools:__pkg__"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
