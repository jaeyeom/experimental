<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jaeyeom.authwatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USER/go/bin/authwatch</string>
    <string>run</string>
    <string>--every</string>
    <string>5m</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
