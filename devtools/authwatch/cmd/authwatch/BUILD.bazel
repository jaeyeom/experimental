load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "help.go",
        "main.go",
        "skill.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/authwatch/cmd/authwatch",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/authwatch:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

go_binary(
    name = "authwatch",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "help_test.go",
        "main_test.go",
        "toolcli_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//devtools/authwatch:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)
