load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/jaeyeom/experimental/devtools/ascii-art/cmd/box-renderer",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/pkg/version:go_default_library",
        "//text/box:go_default_library",
        "//text/canvas:go_default_library",
    ],
)

go_binary(
    name = "box-renderer",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "main_test.go",
        "readme_test.go",
    ],
    data = ["//devtools/ascii-art:README.org"],
    embed = [":go_default_library"],
)

exports_files(
    ["main.go"],
    visibility = ["//devtools:__pkg__"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
