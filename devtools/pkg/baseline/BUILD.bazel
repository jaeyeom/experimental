load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "baseline.go",
        "eval.go",
        "match.go",
        "transition.go",
        "update.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/pkg/baseline",
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "baseline_test.go",
        "eval_test.go",
        "match_test.go",
        "transition_test.go",
        "update_test.go",
    ],
    embed = [":go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
