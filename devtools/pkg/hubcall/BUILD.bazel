go_test(
    name = "go_default_test",
    srcs = [
        "caller_test.go",
        "hubcall_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//devtools/pkg/hubcall/sshtest:go_default_library",
        "//devtools/pkg/remotecall:go_default_library",
    ],
