load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "caller.go",
        "hubcall.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/pkg/hubcall",
    visibility = ["//visibility:public"],
    deps = ["//devtools/pkg/remotecall:go_default_library"],
