load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "codex.go",
        "reviewer.go",
        "reviewpush.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/reviewpush",
    visibility = ["//visibility:public"],
    deps = ["@com_github_jaeyeom_go_cmdexec//:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "codex_test.go",
        "reviewer_test.go",
        "reviewpush_test.go",
    ],
    embed = [":go_default_library"],
    deps = ["@com_github_jaeyeom_go_cmdexec//:go_default_library"],
)

go_test(
    name = "readme_test",
    srcs = ["readme_test.go"],
    data = ["README.md"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
