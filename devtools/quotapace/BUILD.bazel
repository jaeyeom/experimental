load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "check.go",
        "checkpoint.go",
        "gate.go",
        "pace.go",
        "quotapace.go",
        "schedule.go",
        "status.go",
        "store.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/quotapace",
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "gate_test.go",
        "quotapace_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":go_default_library"],
)
