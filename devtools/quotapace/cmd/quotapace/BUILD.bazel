load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "gate.go",
        "main.go",
        "record.go",
        "skill.go",
        "status.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/quotapace/cmd/quotapace",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/pkg/toolcli:go_default_library",
        "//devtools/quotapace:go_default_library",
    ],
)

go_binary(
    name = "quotapace",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "gate_test.go",
        "main_test.go",
        "toolcli_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//devtools/pkg/toolcli:go_default_library",
        "//devtools/quotapace:go_default_library",
    ],
)
