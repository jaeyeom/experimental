load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "credentials.go",
        "keychain_darwin.go",
        "keychain_other.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/quotapace/internal/collect/claude/credentials",
    visibility = ["//devtools/quotapace:__subpackages__"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = ["credentials_test.go"],
    embed = [":go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
