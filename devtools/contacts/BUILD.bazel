load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(["README.org"])

go_library(
    name = "go_default_library",
    srcs = [
        "accesslog.go",
        "age.go",
        "commitments.go",
        "config.go",
        "events.go",
        "people.go",
        "resolve.go",
        "store.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/contacts",
    visibility = ["//visibility:public"],
    deps = [
        "//devtools/pkg/sqlitedb:go_default_library",
        "@com_github_pelletier_go_toml_v2//:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "accesslog_test.go",
        "age_test.go",
        "commitments_test.go",
        "events_test.go",
        "people_test.go",
        "resolve_test.go",
        "store_test.go",
    ],
    embed = [":go_default_library"],
    deps = ["//devtools/pkg/sqlitedb:go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
