load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "commitments.go",
        "history.go",
        "log.go",
        "main.go",
        "people.go",
        "report.go",
        "resolve.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/contacts/cmd/contacts",
    visibility = ["//visibility:private"],
    deps = ["//devtools/contacts:go_default_library"],
)

go_binary(
    name = "contacts",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "commitments_test.go",
        "history_test.go",
        "log_test.go",
        "main_test.go",
        "people_test.go",
        "report_test.go",
        "resolve_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":go_default_library"],
)
