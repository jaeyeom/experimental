load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "age.go",
        "commitments.go",
        "history.go",
        "log.go",
        "main.go",
        "people.go",
        "report.go",
        "resolve.go",
        "skill.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/contacts/cmd/contacts",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/contacts:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
    ],
)

go_binary(
    name = "contacts",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "age_test.go",
        "commitments_test.go",
        "history_test.go",
        "log_test.go",
        "main_test.go",
        "people_test.go",
        "readme_test.go",
        "report_test.go",
        "resolve_test.go",
        "toolcli_test.go",
    ],
    data = glob(["testdata/**"]) + ["//devtools/contacts:README.org"],
    embed = [":go_default_library"],
    deps = ["//devtools/pkg/toolcli:go_default_library"],
)

exports_files(
    ["main.go"],
    visibility = ["//devtools:__pkg__"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
