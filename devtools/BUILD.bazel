# Each command package exports main.go so //devtools/setup-dev/ansible:go_default_test
# and :version_coverage_test can verify every devtools/*/cmd/* binary inside the
# Bazel sandbox and on RBE.
filegroup(
    name = "commands",
    srcs = [pkg + ":main.go" for pkg in _COMMAND_PACKAGES],
    visibility = ["//devtools/setup-dev/ansible:__pkg__"],
)

go_test(
    name = "version_coverage_test",
    size = "small",
    srcs = ["version_test.go"],
    data = [":commands"] + _COMMAND_PACKAGES,
    env = {
        "DEVTOOLS_VERSION_BINS": " ".join([
            "%s=$(rootpath %s)" % (
                pkg.rsplit("/", 1)[-1],
                pkg,
            )
            for pkg in _COMMAND_PACKAGES
        ]),
    },
)
