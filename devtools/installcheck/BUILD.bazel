load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "check.go",
        "config.go",
        "exec.go",
        "github.go",
        "notify.go",
        "paths.go",
        "state.go",
        "status.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/installcheck",
    visibility = ["//visibility:public"],
    deps = [
        "//devtools/pkg/notify:go_default_library",
        "@com_github_google_renameio_v2//:go_default_library",
        "@com_github_pelletier_go_toml_v2//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "check_test.go",
        "config_test.go",
        "notify_test.go",
    ],
    embed = [":go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
