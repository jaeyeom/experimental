load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The userscript test runs on the host's node (node --test), not a Bazel
# JavaScript toolchain, so it must not be sent to RBE. See userscript_test.sh.
sh_test(
    name = "userscript_test",
    size = "small",
    srcs = ["userscript_test.sh"],
    data = [
        "gh-ask.test.js",
        "gh-ask.user.js",
        "testdom.js",
    ] + glob(["testdata/*.html"]),
    tags = ["no-remote"],
)

filegroup(
    name = "sh_srcs",
    srcs = glob(["*.sh"]),
    visibility = ["//tools/lint:__pkg__"],
)
