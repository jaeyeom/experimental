load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "serve.go",
        "slackapi.go",
        "watch.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/slackwatch/cmd/slackwatch",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/slackwatch:go_default_library",
        "@com_github_slack_go_slack//:go_default_library",
        "@com_github_slack_go_slack//slackevents:go_default_library",
        "@com_github_slack_go_slack//socketmode:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

go_binary(
    name = "slackwatch",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "main_test.go",
        "serve_test.go",
        "slackapi_test.go",
        "watch_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//devtools/slackwatch:go_default_library",
        "@com_github_slack_go_slack//:go_default_library",
        "@com_github_slack_go_slack//slackevents:go_default_library",
        "@com_github_slack_go_slack//socketmode:go_default_library",
    ],
)
