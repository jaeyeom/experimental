load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "notify.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/agentbus/cmd/agentbusd",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/agentbus/internal/adapter:go_default_library",
        "//devtools/agentbus/internal/adapter/herdr:go_default_library",
        "//devtools/agentbus/internal/config:go_default_library",
        "//devtools/agentbus/internal/daemon:go_default_library",
        "//devtools/agentbus/internal/hibernate:go_default_library",
        "//devtools/agentbus/internal/lease:go_default_library",
        "//devtools/agentbus/internal/paths:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

go_binary(
    name = "agentbusd",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "main_test.go",
        "notify_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//devtools/agentbus/internal/config:go_default_library",
        "//devtools/agentbus/internal/lease:go_default_library",
    ],
)
