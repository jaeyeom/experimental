<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example launchd agent for the agentbus jobs runner on macOS.
  Installing it is a manual step: copy it to
  ~/Library/LaunchAgents/jobs-runner.plist, replace /Users/YOU, then
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/jobs-runner.plist
  The file name, the label, and the runner name match: orgctl plan looks for the
  agent by the runner's name. Remove the dry-run argument after the shadow week.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jobs-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/go/bin/agentbus</string>
    <string>jobs</string>
    <string>runner</string>
    <string>--name</string>
    <string>jobs-runner</string>
    <string>--dry-run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOU/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/jobs-runner.log</string>
</dict>
</plist>
