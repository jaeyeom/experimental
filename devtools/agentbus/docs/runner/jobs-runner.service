# Example systemd user unit for the agentbus jobs runner on Linux.
# Installing it is a manual step: copy it to
# ~/.config/systemd/user/jobs-runner.service, adjust the paths, then
#   systemctl --user daemon-reload
#   systemctl --user enable --now jobs-runner
# The file name, the unit name, and --name match: orgctl plan looks for
# the unit by the runner's name. Drop --dry-run after the shadow week.
[Unit]
Description=agentbus jobs runner
After=network-online.target

[Service]
ExecStart=%h/go/bin/agentbus jobs runner --name jobs-runner --dry-run
Environment=PATH=%h/go/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=30
# The runner waits for commands under way before it exits.
TimeoutStopSec=20min

[Install]
WantedBy=default.target
