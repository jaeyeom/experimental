load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "config.go",
        "runner.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/agentbus/internal/runner",
    visibility = ["//devtools/agentbus:__subpackages__"],
    deps = ["//devtools/agentbus/internal/jobs:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "config_test.go",
        "runner_test.go",
    ],
    data = ["//devtools/agentbus/docs/runner:runner.json"],
    embed = [":go_default_library"],
    deps = [
        "//devtools/agentbus/internal/eventlog:go_default_library",
        "//devtools/agentbus/internal/jobs:go_default_library",
    ],
)
