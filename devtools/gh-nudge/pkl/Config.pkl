@go.Package { name = "github.com/jaeyeom/experimental/devtools/gh-nudge/internal/config/pkl" }
module gh_nudge.Config

import "package://pkg.pkl-lang.org/pkl-go/pkl.golang@0.14.0#/go.pkl"

/// GitHub-related configuration
class GitHubConfig {
  /// Repository owner (organization or user). Defaults to authenticated user.
  owner: String?
  /// List of repository names to monitor
  repos: Listing<String>
}

/// Channel routing rule based on file patterns
class ChannelRoutingConfig {
  /// Regex pattern to match file paths
  pattern: String
  /// Slack channel to route matching PRs to
  channel: String
}

/// A label that must have been on the pull request for a minimum time.
class LabelAgeConfig {
  /// Label name. Matched exactly, including case.
  label: String(!isEmpty)
  /// Minimum hours since that label was most recently added.
  min_hours: Int(this > 0)
}

/// Slack-related configuration.
/// gh-merge queue and watch do not read these fields. Empty values are valid.
class SlackConfig {
  /// Slack Bot OAuth token (starts with xoxb-). Empty when Slack is unused.
  token: String = ""
  /// Fallback channel if no routing patterns match. Empty when Slack is unused.
  default_channel: String = ""
  /// GitHub username to Slack user ID mapping (for @mentions)
  user_id_mapping: Mapping<String, String> = new {}
  /// GitHub username to Slack DM channel ID mapping
  dm_channel_id_mapping: Mapping<String, String> = new {}
  /// Channel routing rules based on file patterns
  channel_routing: Listing<ChannelRoutingConfig> = new {}
}

/// General application settings
class SettingsConfig {
  /// Hours between reminder notifications for the same outstanding review request
  reminder_threshold_hours: Int(this > 0) = 24
  /// Only send notifications during working hours
  working_hours_only: Boolean = false
  /// Template for reminder messages. Variables: {slack_id}, {title}, {hours}, {url}
  message_template: String = "Hey <@{slack_id}>, the PR '{title}' has been waiting for your review for {hours} hours."
  /// Send DMs to reviewers by default instead of channel messages
  dm_by_default: Boolean = false
  /// Skip nudging unless the PR has all of these labels. Empty means no requirement.
  require_labels: Listing<String> = new {}
  /// Skip nudging if the PR has any of these labels. Empty means no skip filter.
  skip_labels: Listing<String> = new {}
  /// Skip nudging these GitHub users. Empty means no users are skipped.
  /// Skipped users do not need a Slack user ID mapping.
  skip_users: Listing<String> = new {}
  /// Each entry must be present and at least this old since it was last added.
  /// Empty means no label-age requirement. Every entry is required.
  require_label_ages: Listing<LabelAgeConfig> = new {}
  /// Minimum hours since this reviewer was first requested on the pull request.
  /// Zero means no first-request age requirement. A later request does not restart the clock.
  min_first_review_request_hours: Int(this >= 0) = 0
  /// Labels that stop gh-merge from merging a pull request.
  /// gh-nudge ignores this list. Empty means no label blocks a merge.
  /// Names match exactly, including case. For example, "do-not-merge".
  block_merge_labels: Listing<String> = new {}
  /// Check names that must be green before gh-merge queue enqueues.
  /// Empty makes queue refuse unless --allow-no-required-checks is set.
  /// Names match exactly, including case.
  required_checks: Listing<String> = new {}
  /// Regular expressions matched against a failing merge-queue log.
  /// A match is a hint, not a verdict. Empty means no hints.
  flake_signatures: Listing<String> = new {}
  /// Comment template that must match before a removed pull request can be
  /// queued again. Placeholders are {event_id} and {class}.
  /// Class is our-code, flake, or infra. Empty matches nothing.
  rca_marker: String = ""
  /// How many earlier flake or infra requeues are allowed.
  /// gh-merge queue refuses when the timeline count is greater than this.
  /// Zero means no requeue is allowed.
  max_requeues: Int(this >= 0) = 2
  /// Lines of a CircleCI failing step that match this regular expression are
  /// printed with the log tail. An invalid pattern fails config load.
  /// The default matches a line that starts with ERROR: and a timestamp
  /// prefix such as (12:34:56) ERROR:.
  failure_log_pattern: String = #"^(?:[(][0-9]{2}:[0-9]{2}:[0-9]{2}[)] )?ERROR:"#
  /// How gh-merge reads CircleCI logs: auto, api, or cli.
  /// auto uses the HTTP API when CIRCLE_TOKEN is set, and the circleci CLI otherwise.
  /// api keeps the HTTP path. cli uses the CLI even when a token is set and does
  /// not call the HTTP API.
  /// The CLI may read its token from the system keyring and then needs an unsandboxed environment.
  circleci_log: String = "auto"
}

/// Settings gh-merge reads for one repository.
/// A field set on the entry replaces the global field.
/// A field left unset inherits the global field.
/// An explicit empty list is set, and it does not inherit.
/// gh-nudge ignores this class.
class RepoSettings {
  /// Labels that stop gh-merge from merging a pull request.
  /// Unset inherits settings.block_merge_labels. An empty list blocks nothing.
  block_merge_labels: Listing<String>?
  /// Check names that must be green before gh-merge queue enqueues.
  /// Unset inherits settings.required_checks.
  /// An empty list still makes queue refuse unless --allow-no-required-checks is set.
  required_checks: Listing<String>?
  /// Regular expressions matched against a failing merge-queue log.
  /// Unset inherits settings.flake_signatures. An empty list adds no hints.
  flake_signatures: Listing<String>?
  /// Comment template that must match before a removed pull request can be
  /// queued again. Placeholders are {event_id} and {class}.
  /// Unset inherits settings.rca_marker. An empty string matches nothing.
  rca_marker: String?
  /// How many earlier flake or infra requeues are allowed.
  /// Unset inherits settings.max_requeues. Zero means no requeue is allowed.
  max_requeues: Int(this >= 0)?
  /// Lines of a CircleCI failing step that match this regular expression.
  /// Unset inherits settings.failure_log_pattern.
  /// An empty string uses the default pattern.
  failure_log_pattern: String?
  /// How gh-merge reads CircleCI logs: auto, api, or cli.
  /// Unset inherits settings.circleci_log. An empty string means auto.
  circleci_log: String?
}

/// Root configuration
github: GitHubConfig
slack: SlackConfig = new {}
settings: SettingsConfig = new {}
/// gh-merge settings for one <owner>/<repo> key.
/// A missing key uses the global settings. gh-nudge ignores this mapping.
/// An explicit empty list on an entry does not inherit the global list.
repo_settings: Mapping<String, RepoSettings> = new {}
