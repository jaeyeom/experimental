load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "skill.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/gh-nudge/cmd/gh-pr-review",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/gh-nudge/internal/argparser:go_default_library",
        "//devtools/gh-nudge/internal/config:go_default_library",
        "//devtools/gh-nudge/internal/git:go_default_library",
        "//devtools/gh-nudge/internal/github:go_default_library",
        "//devtools/gh-nudge/internal/models:go_default_library",
        "//devtools/gh-nudge/internal/prreview:go_default_library",
        "//devtools/gh-nudge/internal/storage:go_default_library",
        "@com_github_chorong_sh_chorong//pkg/toolcli:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_binary(
    name = "gh-pr-review",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "rerequest_test.go",
        "submit_test.go",
        "toolcli_test.go",
    ],
    data = [
        "//devtools/gh-nudge/pkl:config_pkl",
        "@pkl_project//:packages",
    ] + select({
        "@bazel_tools//src/conditions:darwin_arm64": ["@pkl-cli-macos-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:darwin_arm64e": ["@pkl-cli-macos-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:darwin_x86_64": ["@pkl-cli-macos-amd64//file:downloaded"],
        "@bazel_tools//src/conditions:linux_aarch64": ["@pkl-cli-linux-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:linux_x86_64": ["@pkl-cli-linux-amd64//file:downloaded"],
        "//conditions:default": [],
    }),
    embed = [":go_default_library"],
    deps = [
        "//devtools/gh-nudge/internal/argparser:go_default_library",
        "//devtools/gh-nudge/internal/github:go_default_library",
        "//devtools/gh-nudge/internal/models:go_default_library",
        "//devtools/gh-nudge/internal/prreview:go_default_library",
        "//devtools/gh-nudge/internal/storage:go_default_library",
        "@com_github_chorong_sh_chorong//pkg/toolcli:go_default_library",
    ],
)

exports_files(
    ["main.go"],
    visibility = [
        "//devtools:__pkg__",
        "//devtools/gh-nudge/cmd:__pkg__",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
