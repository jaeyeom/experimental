load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "circleci.go",
        "dequeue.go",
        "ejection.go",
        "evidence.go",
        "list.go",
        "main.go",
        "queue.go",
        "rca.go",
        "requeue.go",
        "skill.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/gh-nudge/cmd/gh-merge",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/gh-nudge/internal/config:go_default_library",
        "//devtools/gh-nudge/internal/github:go_default_library",
        "//devtools/gh-nudge/internal/models:go_default_library",
        "//devtools/gh-nudge/rcamarker:go_default_library",
        "//devtools/pkg/ghcli:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_binary(
    name = "gh-merge",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "circleci_test.go",
        "ejection_test.go",
        "evidence_test.go",
        "list_test.go",
        "main_test.go",
        "queue_test.go",
        "rca_test.go",
        "requeue_test.go",
        "toolcli_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":go_default_library"],
    deps = [
        "//devtools/gh-nudge/internal/config:go_default_library",
        "//devtools/gh-nudge/internal/github:go_default_library",
        "//devtools/gh-nudge/internal/models:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
    ],
)

exports_files(
    ["main.go"],
    visibility = [
        "//devtools:__pkg__",
        "//devtools/gh-nudge/cmd:__pkg__",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
