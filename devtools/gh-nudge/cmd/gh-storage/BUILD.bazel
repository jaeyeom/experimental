load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "skill.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/gh-nudge/cmd/gh-storage",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/gh-nudge/internal/argparser:go_default_library",
        "//devtools/gh-nudge/internal/storage:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
    ],
)

go_binary(
    name = "gh-storage",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = ["toolcli_test.go"],
    embed = [":go_default_library"],
    deps = ["//devtools/pkg/toolcli:go_default_library"],
)

exports_files(
    ["main.go"],
    visibility = ["//devtools/gh-nudge/cmd:__pkg__"],
)
