load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/jaeyeom/experimental/devtools/gh-nudge/cmd/gh-throttle",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/pkg/ghlimit:go_default_library",
        "//devtools/pkg/procinfo:go_default_library",
    ],
)

go_binary(
    name = "gh-throttle",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
    deps = ["//devtools/pkg/procinfo:go_default_library"],
)
