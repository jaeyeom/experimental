load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "skill.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/gh-nudge/cmd/gh-approve",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/gh-nudge/internal/approve:go_default_library",
        "//devtools/gh-nudge/internal/config:go_default_library",
        "//devtools/gh-nudge/internal/github:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_binary(
    name = "gh-approve",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "main_test.go",
        "toolcli_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//devtools/gh-nudge/internal/config:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
    ],
)

exports_files(
    ["main.go"],
    visibility = ["//devtools/gh-nudge/cmd:__pkg__"],
)
