load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "skill.go",
        "toolcli.go",
    ],
    embedsrcs = ["skill.md"],
    importpath = "github.com/jaeyeom/experimental/devtools/gh-nudge/cmd/gh-codeowners",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/gh-nudge/internal/codeowners:go_default_library",
        "//devtools/pkg/toolcli:go_default_library",
        "//devtools/pkg/version:go_default_library",
    ],
)

go_binary(
    name = "gh-codeowners",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = ["toolcli_test.go"],
    embed = [":go_default_library"],
    deps = ["//devtools/pkg/toolcli:go_default_library"],
)

exports_files(
    ["main.go"],
    visibility = [
        "//devtools:__pkg__",
        "//devtools/gh-nudge/cmd:__pkg__",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
