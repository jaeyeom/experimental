load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "approve.go",
        "config.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/gh-nudge/internal/config",
    visibility = ["//devtools/gh-nudge:__subpackages__"],
    deps = [
        "//devtools/gh-nudge/internal/config/pkl:go_default_library",
        "//devtools/gh-nudge/internal/slack:go_default_library",
        "//devtools/pkg/genfiles:go_default_library",
        "@com_github_apple_pkl_go//pkl:go_default_library",
        "@com_github_bmatcuk_doublestar_v4//:go_default_library",
        "@in_gopkg_yaml_v3//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "approve_test.go",
        "config_test.go",
    ],
    data = [
        "//devtools/gh-nudge/pkl:config_pkl",
        "//devtools/gh-nudge/pkl:example.config.pkl",
    ] + select({
        "@bazel_tools//src/conditions:darwin_arm64": ["@pkl-cli-macos-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:darwin_arm64e": ["@pkl-cli-macos-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:darwin_x86_64": ["@pkl-cli-macos-amd64//file:downloaded"],
        "@bazel_tools//src/conditions:linux_aarch64": ["@pkl-cli-linux-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:linux_x86_64": ["@pkl-cli-linux-amd64//file:downloaded"],
        "//conditions:default": [],
    }),
    embed = [":go_default_library"],
    tags = ["no-remote"],  # Config.pkl fetches package://pkg.pkl-lang.org/... over the network
    deps = ["//devtools/gh-nudge/internal/config/pkl:go_default_library"],
)
