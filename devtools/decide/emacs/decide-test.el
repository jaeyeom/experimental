(defun decide-test--draft-item ()
  "An open thread whose latest message is a long draft with options."
  (let* ((words (mapconcat (lambda (i) (format "draftword%d" i))
                           (number-sequence 0 39) " "))
         (draft (concat words " draftend")))
    `(("id" . "D-001")
      ("owner" . "ada")
      ("state" . "open")
      ("kind" . "relay")
      ("question" . "what should I send?")
      ("messages" .
       ((("author" . "ada") ("text" . "what should I send?"))
        (("author" . "ada") ("text" . ,draft))))
      ("options" .
       ((("key" . "send") ("label" . "send"))
        (("key" . "edit") ("label" . "edit"))
        (("key" . "don't send") ("label" . "don't send")))))))

(ert-deftest decide-item-shows-thread-reply-and-archive ()
  (let ((item (decide-test--draft-item))
        (note '(("id" . "D-002")
                ("owner" . "ada")
                ("state" . "open")
                ("kind" . "relay")
                ("question" . "progress note")
                ("messages" .
                 ((("author" . "ada") ("text" . "progress note"))))))
        (calls nil))
    (cl-letf (((symbol-function 'decide--json)
               (lambda (_args) item))
              ((symbol-function 'decide--command)
               (lambda (args)
                 (setq calls (cons args calls))
                 ""))
              ((symbol-function 'completing-read)
               (lambda (&rest _) "send")))
      (unwind-protect
          (progn
            (decide-show-id "D-001")
            (with-current-buffer "*decide D-001*"
              (should visual-line-mode)
              (should-not truncate-lines)
              (let ((text (buffer-string)))
                (should (string-match-p "draftword0" text))
                (should (string-match-p "draftend" text))
                (should (< (string-match "draftword0" text)
                           (string-match "draftend" text)))
                (should (< (string-match "draftend" text)
                           (string-match "reply:" text)))
                (should (< (string-match "reply:" text)
                           (string-match "1 send" text)))
                (should (< (string-match "1 send" text)
                           (string-match "3 don't send" text))))
              (setq calls nil)
              (call-interactively #'decide-answer-option)
              (should (equal (car calls) '("answer" "--json" "D-001" "send")))
              (setq calls nil)
              (let ((last-command-event ?1))
                (call-interactively #'decide-answer-number))
              (should (equal (car calls) '("answer" "--json" "D-001" "send")))
              (setq calls nil)
              (call-interactively #'decide-archive)
              (should-not calls)
              (should (eq (key-binding (kbd "r")) #'decide-reply))
              (should (eq (key-binding (kbd "y")) #'decide-archive))
              (call-interactively #'decide-reply))
            (with-current-buffer "*decide reply D-001*"
              (insert "edits")
              (call-interactively #'decide-reply-send))
            (should (equal (car calls) '("send" "--id" "D-001" "--json" "edits")))
            (setq item note)
            (decide-show-id "D-002")
            (setq calls nil)
            (with-current-buffer "*decide D-002*"
              (call-interactively #'decide-archive))
            (should (equal (car calls) '("done" "--json" "D-002" "archived"))))
        (dolist (name '("*decide D-001*" "*decide D-002*"
                        "*decide reply D-001*" "*decide answer D-001*"))
          (when (get-buffer name)
            (kill-buffer name)))))
    (when (decide-test--evil-ready-p)
      (with-temp-buffer
        (decide-item-mode)
        (evil-local-mode 1)
        (evil-normal-state)
        (should (eq (key-binding (kbd "r")) #'decide-reply))
        (should (eq (key-binding (kbd "y")) #'decide-archive))))))

(ert-deftest decide-display-reuses-the-selected-window ()
  (let ((rows '((("id" . "D-1") ("owner" . "ada") ("question" . "one"))))
        (item '(("id" . "D-1")
                ("owner" . "ada")
                ("state" . "open")
                ("kind" . "relay")
                ("question" . "one"))))
    (cl-letf (((symbol-function 'decide--json)
               (lambda (args)
                 (cond ((member "show" args) item)
                       ((member "status" args) nil)
                       (t rows)))))
      (unwind-protect
          (progn
            (should (equal decide-display-buffer-action
                           '(display-buffer-same-window)))
            (let ((seen nil))
              (cl-letf (((symbol-function 'pop-to-buffer)
                         (lambda (buffer &optional action &rest _)
                           (setq seen action)
                           buffer)))
                (let ((decide-display-buffer-action '(display-buffer-no-window)))
                  (decide-list "inbox")
                  (should (equal seen '(display-buffer-no-window))))))
            (delete-other-windows)
            (split-window)
            (let ((here (selected-window))
                  (other (next-window)))
              (decide-list "inbox")
              (should (eq (selected-window) here))
              (should (eq (window-buffer here) (get-buffer "*decide*")))
              (should-not (eq (window-buffer other) (get-buffer "*decide*")))
              (with-current-buffer "*decide*"
                (decide--goto-id "D-1")
                (call-interactively #'decide-show))
              (should (eq (selected-window) here))
              (should (eq (window-buffer here) (get-buffer "*decide D-1*")))
              (should-not (eq (window-buffer other) (get-buffer "*decide D-1*")))
              (decide-list-inbox)
              (should (eq (window-buffer here) (get-buffer "*decide*")))
              (with-current-buffer "*decide*"
                (decide--goto-id "D-1")
                (call-interactively #'decide-show))
              (call-interactively #'quit-window)
              (should (eq (selected-window) here))
              (should (eq (window-buffer here) (get-buffer "*decide*")))
              (decide-status)
              (should (eq (selected-window) here))
              (should (eq (window-buffer here) (get-buffer "*decide status*")))
              (should-not (eq (window-buffer other) (get-buffer "*decide status*")))))
        (dolist (name '("*decide*" "*decide D-1*" "*decide status*"))
          (when (get-buffer name)
            (kill-buffer name)))
        (delete-other-windows)))))

(defun decide-test--has-face (text face)
  "Non-nil when TEXT uses FACE."
  (let ((pos 0)
        found)
    (while (and (not found) (< pos (length text)))
      (if (eq (get-text-property pos 'face text) face)
          (setq found t)
        (setq pos (1+ pos))))
    found))

(defun decide-test--header-colons (text)
  "Column of each header colon in TEXT."
  (let (cols)
    (dolist (line (split-string text "\n"))
      (when (string-match
             "\\` *\\(From\\|To\\|Kind\\|State\\|Created\\|Answered\\):"
             line)
        (push (string-match ":" line) cols)))
    (nreverse cols)))

(ert-deftest decide-list-faces-and-item-header-align ()
  (should (facep 'decide-requester))
  (should (facep 'decide-time))
  (should (facep 'decide-badge))
  (let* ((ask '(("id" . "D-1")
                ("owner" . "ada")
                ("kind" . "relay")
                ("state" . "open")
                ("question" . "ship it?")
                ("createdAt" . "2026-11-01T00:00:00Z")))
         (thread '(("id" . "D-2")
                   ("owner" . "beta")
                   ("kind" . "relay")
                   ("state" . "open")
                   ("createdAt" . "2026-11-01T00:00:00Z")
                   ("answeredAt" . "2026-11-02T03:04:05Z")
                   ("messages" .
                    ((("author" . "human") ("text" . "please look"))))))
         (line (decide--list-line ask))
         (ask-text (decide--item-text ask))
         (thread-text (decide--item-text thread))
         (ask-colons (decide-test--header-colons ask-text))
         (thread-colons (decide-test--header-colons thread-text)))
    (should (decide-test--has-face line 'decide-requester))
    (should (decide-test--has-face line 'decide-time))
    (should (decide-test--has-face line 'decide-badge))
    (should (eq (get-text-property (string-match "ada" line) 'face line)
                'decide-requester))
    (should (eq (get-text-property (string-match "relay" line) 'face line)
                'decide-badge))
    (should (= (length ask-colons) 5))
    (should (apply #'= ask-colons))
    (should-not (string-match-p "^ *To:" ask-text))
    (should (string-match-p "From: ada" ask-text))
    (should (string-match-p "Answered: \n\nship it?" ask-text))
    (should (= (length thread-colons) 6))
    (should (apply #'= thread-colons))
    (should (string-match-p "From: human" thread-text))
    (should (string-match-p "To: beta" thread-text))
    (should (string-match-p "Created: 2026-11-01T00:00:00Z" thread-text))
    (should (string-match-p "Answered: 2026-11-02T03:04:05Z" thread-text))
    (should (string-match-p "Answered: 2026-11-02T03:04:05Z\n\nhuman" thread-text))))

(defun decide-test--use-program ()
  "Point `decide-program' at DECIDE_PROGRAM."
  (let ((program (getenv "DECIDE_PROGRAM")))
    (unless (and program (not (string-empty-p program)))
      (ert-skip "DECIDE_PROGRAM is not set"))
    (setq decide-program program)))

(defun decide-test--seed-thread ()
  "Store a root ask, a human note, and an agent draft.  Return the id."
  (decide-test--use-program)
  (let ((id (string-trim
             (decide--command
              '("ask" "--owner" "ada" "--kind" "relay"
                "--option" "y:Yes" "--option" "n:No" "--rec" "y"
                "--free-text" "--notify-pane" "pane-9" "root ask")))))
    (decide--command (list "answer" id "human note"))
    (decide--command
     (list "reply" id "agent draft"
           "--option" "keep:Keep" "--option" "drop:Drop" "--rec" "keep"))
    id))

(defun decide-test--texts (id)
  "Message texts of stored thread ID, in order."
  (let ((item (decide--json (list "show" "--json" id))))
    (mapcar (lambda (msg) (decide--field msg "text"))
            (or (alist-get "messages" item nil nil #'equal) '()))))

(defun decide-test--assert-stored (id new-text)
  "Assert ID still has the seeded texts followed by NEW-TEXT."
  (should (equal (decide-test--texts id)
                 (list "root ask" "human note" "agent draft" new-text))))

(ert-deftest decide-stored-answer-appends ()
  "Answering from the answer buffer appends and keeps the thread."
  :tags '(decide-stored)
  (let ((id (decide-test--seed-thread)))
    (with-current-buffer (get-buffer-create (format "*decide answer %s*" id))
      (decide-answer-mode)
      (setq decide--item-id id)
      (insert "keep")
      (decide-answer-send))
    (decide-test--assert-stored id "keep")))

(ert-deftest decide-stored-reply-appends ()
  "Sending the reply buffer appends a human message and keeps the thread."
  :tags '(decide-stored)
  (let ((id (decide-test--seed-thread)))
    (with-current-buffer (get-buffer-create (format "*decide reply %s*" id))
      (decide-reply-mode)
      (setq decide--item-id id)
      (insert "please edit")
      (decide-reply-send))
    (decide-test--assert-stored id "please edit")))

(ert-deftest decide-stored-compose-appends ()
  "The reply command is the compose path and only appends."
  :tags '(decide-stored)
  (let ((id (decide-test--seed-thread)))
    (with-current-buffer (get-buffer-create (format "*decide reply %s*" id))
      (decide-reply-mode)
      (setq decide--item-id id)
      (insert "compose note")
      (decide-reply-send))
    (decide-test--assert-stored id "compose note")))

(provide 'decide-test)

