load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "notify.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/decide/cmd/decide",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/decide:go_default_library",
        "//devtools/decide/tui:go_default_library",
    ],
)

go_binary(
    name = "decide",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
    deps = ["//devtools/decide:go_default_library"],
)
