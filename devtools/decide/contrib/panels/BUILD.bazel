load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//devtools/linters/pylinters:py_entries.bzl", "py_entries_manifest")

py_library(
    name = "panels_lib",
    srcs = [
        "agent_memory.py",
        "tokens.py",
    ],
    imports = ["."],
)

py_binary(
    name = "tokens",
    srcs = ["tokens.py"],
    imports = ["."],
    legacy_create_init = 0,
    main = "tokens.py",
    deps = [":panels_lib"],
)

py_binary(
    name = "agent_memory",
    srcs = ["agent_memory.py"],
    imports = ["."],
    legacy_create_init = 0,
    main = "agent_memory.py",
    deps = [":panels_lib"],
)

py_test(
    name = "tokens_test",
    size = "small",
    srcs = ["tokens_test.py"],
    imports = ["."],
    legacy_create_init = 0,
    deps = [
        ":panels_lib",
        "@pypi//pytest",
    ],
)

py_test(
    name = "agent_memory_test",
    size = "small",
    srcs = ["agent_memory_test.py"],
    imports = ["."],
    legacy_create_init = 0,
    deps = [
        ":panels_lib",
        "@pypi//pytest",
    ],
)

sh_binary(
    name = "tokens_sh",
    srcs = ["tokens.sh"],
    data = ["tokens.py"],
)

sh_binary(
    name = "agent_memory_sh",
    srcs = ["agent-memory.sh"],
    data = ["agent_memory.py"],
)

sh_test(
    name = "panels_test",
    size = "small",
    srcs = ["panels_test.sh"],
    args = [
        "$(rootpath //devtools/decide/cmd/decide)",
        "$(rootpath tokens.sh)",
        "$(rootpath agent-memory.sh)",
    ],
    data = [
        "agent-memory.sh",
        "agent_memory.py",
        "tokens.py",
        "tokens.sh",
        "//devtools/decide/cmd/decide",
    ],
)

filegroup(
    name = "sh_srcs",
    srcs = glob(["*.sh"]),
    visibility = ["//tools/lint:__pkg__"],
)

filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
    visibility = ["//devtools/linters/pylinters:__pkg__"],
)

py_entries_manifest(
    name = "py_entries",
    visibility = ["//devtools/linters/pylinters:__pkg__"],
)
