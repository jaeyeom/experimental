load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_library(
    name = "go_default_library",
    srcs = [
        "api.go",
        "auth.go",
        "handlers_drafts.go",
        "handlers_push.go",
        "handlers_read.go",
        "handlers_write.go",
        "presence.go",
        "push_dispatch.go",
        "push_store.go",
        "server.go",
        "sse.go",
        "static.go",
        "webpush_crypto.go",
    ],
    embedsrcs = [
        "static/api.js",
        "static/app.js",
        "static/dom.js",
        "static/draft_sync.js",
        "static/icons/icon-maskable.svg",
        "static/icons/icon.svg",
        "static/inbox_model.js",
        "static/inbox_view.js",
        "static/index.html",
        "static/manifest.webmanifest",
        "static/sheet.js",
        "static/snooze_sheet.js",
        "static/store.js",
        "static/styles.css",
        "static/swipe.js",
        "static/sw.js",
        "static/text_render.js",
        "static/thread_model.js",
        "static/thread_view.js",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/decide/web",
    visibility = ["//visibility:public"],
    deps = [
        "//devtools/decide:go_default_library",
        "//devtools/decide/inboxrpc:go_default_library",
        "//devtools/decide/tui:go_default_library",
        "@com_github_google_renameio_v2//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "api_test.go",
        "push_dispatch_test.go",
        "push_test.go",
        "server_test.go",
        "sse_test.go",
        "static_test.go",
        "webpush_crypto_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//devtools/decide:go_default_library",
        "//devtools/decide/inboxrpc:go_default_library",
        "//devtools/decide/tui:go_default_library",
    ],
)

# The front-end test runs on the host's node (node --test), not a Bazel
# JavaScript toolchain, so it must not be sent to RBE. See static_test.sh.
sh_test(
    name = "static_test",
    size = "small",
    srcs = ["static_test.sh"],
    data = glob(["static/*.js"]) + glob(["static/*_test.mjs"]),
    tags = ["no-remote"],
)
