amends "../Org.pkl"

org = "Fixture"

machines {
  ["one"] {
    host = "one.example"
    herdrHandle = "one"
    timezone = "UTC"
  }
}

rules {
  new { id = "plain-words"; text = "Be clear."; source = "fixture" }
}

roles {
  ["a/one"] {
    machine = "one"
    workspace = "hq"
    tab = "one"
    cwd = "/work"
    agent = "coder"
  }
}

jobs {
  policy = "/work/policy.json"
  anomalyRole = "a/one"
  runners {
    ["jobs-runner"] {
      machine = "missing"
      kinds { "merge" }
    }
  }
}
