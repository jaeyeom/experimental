amends "../Org.pkl"

org = "Fixture"

approvalWords { "ship" }

allowApprovalWords { "merge" }

machines {
  ["one"] {
    host = "one.example"
    herdrHandle = "one"
    timezone = "UTC"
  }
}

rules {
  new { id = "plain-words"; text = "Be clear."; source = "fixture" }
}

roles {
  ["coord/lead"] {
    machine = "one"
    workspace = "hq"
    tab = "lead"
    cwd = "/work"
    agent = "coordinator"
    decides { "triage incoming issues" }
  }
}
