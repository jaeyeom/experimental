amends "../Org.pkl"

org = "Fixture"

machines {
  ["one"] {
    host = "one.example"
    herdrHandle = "one"
    timezone = "UTC"
  }
}

rules {
  new { id = "plain-words"; text = "Be clear."; source = "fixture" }
}

roles {
  ["a/one"] {
    machine = "one"
    workspace = "hq"
    tab = "one"
    cwd = "/work"
    agent = "coder"
  }
}

pools {
  ["hands"] {
    machine = "one"
    workspace = "hq"
    starter = "a/one"
    max = 1
    schedules {
      new { id = "nope"; cron = "0 * * * *"; prompt = "no" }
    }
  }
}
