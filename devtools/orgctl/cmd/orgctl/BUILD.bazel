load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "live.go",
        "main.go",
        "tree.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/orgctl/cmd/orgctl",
    visibility = ["//visibility:private"],
    deps = [
        "//devtools/orgctl:go_default_library",
        "//devtools/orgctl/adapter/agentbus:go_default_library",
        "//devtools/orgctl/adapter/crons:go_default_library",
        "//devtools/orgctl/adapter/herdr:go_default_library",
    ],
)

go_binary(
    name = "orgctl",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
    deps = ["//devtools/orgctl:go_default_library"],
)
