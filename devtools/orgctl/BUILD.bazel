load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/org-lint:defs.bzl", "org_lint_tests")

go_library(
    name = "go_default_library",
    srcs = [
        "brief.go",
        "decides.go",
        "drift.go",
        "import.go",
        "plan.go",
        "spec.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/orgctl",
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "brief_test.go",
        "decides_test.go",
        "drift_test.go",
        "import_test.go",
        "plan_test.go",
        "spec_test.go",
    ],
    data = glob(["**/*.pkl"]),
    embed = [":go_default_library"],
    tags = ["no-sandbox"],
)

org_lint_tests(["README.org"])
