load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files([
    "README.org",
    "examples/acme.pkl",
    "pkl/Org.pkl",
])

go_library(
    name = "go_default_library",
    srcs = [
        "agentsmd.go",
        "brief.go",
        "cronpublish.go",
        "decides.go",
        "diff.go",
        "drift.go",
        "import.go",
        "path.go",
        "plan.go",
        "spec.go",
        "tree.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/orgctl",
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "agentsmd_test.go",
        "brief_test.go",
        "cronpublish_test.go",
        "decides_test.go",
        "diff_test.go",
        "drift_test.go",
        "import_test.go",
        "path_test.go",
        "plan_test.go",
        "readme_test.go",
        "spec_test.go",
        "tree_test.go",
    ],
    data = glob(["**/*.pkl"]) + [
        "README.org",
        "//devtools:README.org",
        "//devtools/orgctl/docs:reference.org",
    ] + select({
        "@bazel_tools//src/conditions:darwin_arm64": ["@pkl-cli-macos-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:darwin_arm64e": ["@pkl-cli-macos-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:darwin_x86_64": ["@pkl-cli-macos-amd64//file:downloaded"],
        "@bazel_tools//src/conditions:linux_aarch64": ["@pkl-cli-linux-aarch64//file:downloaded"],
        "@bazel_tools//src/conditions:linux_x86_64": ["@pkl-cli-linux-amd64//file:downloaded"],
        "//conditions:default": [],
    }),
    embed = [":go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
