load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "go_default_library",
    srcs = [
        "hub.go",
        "service.go",
        "store.go",
    ],
    importpath = "github.com/jaeyeom/experimental/devtools/agent-pool/internal/broker",
    visibility = ["//devtools/agent-pool:__subpackages__"],
    deps = [
        "//devtools/agent-pool/internal/broker/ghacl:go_default_library",
        "//devtools/agent-pool/internal/catalog:go_default_library",
        "//devtools/agent-pool/internal/dlp:go_default_library",
        "//devtools/agent-pool/internal/protocol:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
