load("@gazelle//:def.bzl", "gazelle")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Gazelle configuration
gazelle(
    name = "gazelle",
    command = "fix",
    extra_args = [
        "-build_file_name=BUILD.bazel",
        "-repo_root=.",
        "-go_naming_convention=go_default_library",
        "-go_prefix=github.com/jaeyeom/experimental",
    ],
    prefix = "github.com/jaeyeom/experimental",
)

# Update BUILD.bazel files
gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go.mod",
        "-to_macro=deps.bzl%go_dependencies",
        "-prune",
    ],
    command = "update-repos",
)

# Format alias
alias(
    name = "format",
    actual = "//tools/format:format",
)

exports_files(
    [
        "CHANGELOG.md",
        "MODULE.bazel",
        "PklProject",
        "PklProject.deps.json",
        "go.mod",
        ".gitleaks.toml",
        ".release-please-manifest.json",
        ".shellcheckrc",
        "pyproject.toml",
        "release-please-config.json",
        "uv.lock",
        ".baselines/agents-md-size.json",
    ],
)

# Shell scripts for linting
sh_binary(
    name = "check-bazel-src-files",
    srcs = ["check-bazel-src-files.sh"],
)

filegroup(
    name = "sh_srcs",
    srcs = glob(["*.sh"]),
    visibility = ["//tools/lint:__pkg__"],
)

filegroup(
    name = "semgrep_config",
    srcs = glob([".semgrep/**/*.yaml"]),
    visibility = ["//tools/lint:__pkg__"],
)

filegroup(
    name = "yaml_srcs",
    srcs = glob(
        [
            "**/*.yml",
            "**/*.yaml",
        ],
        allow_empty = True,
        exclude = [
            "**/node_modules/**",
            ".bazel-*/**",
            ".cache/**",
            ".venv/**",
            "bazel-*/**",
        ],
    ),
    visibility = ["//tools/lint:__pkg__"],
)

filegroup(
    name = "template_srcs",
    srcs = glob(
        [
            "**/*.gohtml",
            "**/*.html",
            "**/*.thtml",
            "**/*.tmpl",
            "**/*.tpl",
        ],
        allow_empty = True,
        exclude = [
            "**/node_modules/**",
            ".bazel-*/**",
            ".cache/**",
            ".venv/**",
            "bazel-*/**",
        ],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
