load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//devtools/linters/pylinters:py_entries.bzl", "py_entries_manifest")

sh_binary(
    name = "update-env-keys",
    srcs = ["update-env-keys.sh"],
)

py_library(
    name = "strip_pr_html_comments_lib",
    srcs = ["strip_pr_html_comments.py"],
    imports = ["."],
)

py_binary(
    name = "strip_pr_html_comments",
    srcs = ["strip_pr_html_comments.py"],
    imports = ["."],
    main = "strip_pr_html_comments.py",
    deps = [":strip_pr_html_comments_lib"],
)

py_test(
    name = "strip_pr_html_comments_test",
    srcs = ["strip_pr_html_comments_test.py"],
    data = ["//.github:pull_request_template.md"],
    imports = ["."],
    deps = [
        ":strip_pr_html_comments_lib",
        "@pypi//pytest",
    ],
)

filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
    visibility = ["//devtools/linters/pylinters:__pkg__"],
)

py_entries_manifest(
    name = "py_entries",
    visibility = ["//devtools/linters/pylinters:__pkg__"],
)
